		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.2.0"
	},
	"dependencies": {
		"@sanity/client": "^7.26.0",
		"@sanity/image-url": "^2.1.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"blurhash": "^2.0.5",
		"groq": "^6.8.0"
	}
